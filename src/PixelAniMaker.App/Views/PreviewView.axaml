<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PixelAniMaker.App.ViewModels"
             xmlns:c="using:PixelAniMaker.App.Controls"
             xmlns:rig="using:PixelAniMaker.Core.Rigging"
             xmlns:conv="using:PixelAniMaker.App.Converters"
             x:Class="PixelAniMaker.App.Views.PreviewView"
             x:DataType="vm:PreviewViewModel">
  <ScrollViewer HorizontalScrollBarVisibility="Auto">
    <StackPanel Margin="12" Spacing="12">
      <TextBlock Text="방향별 (×1) — 클릭하면 그 방향으로 전환" FontSize="11" Foreground="#999999" />
      <ItemsControl ItemsSource="{Binding Session.Directions}" HorizontalAlignment="Left">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <UniformGrid Columns="2" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="rig:Direction">
            <StackPanel Spacing="4" Margin="0,0,10,10">
              <TextBlock Text="{Binding Converter={x:Static conv:DirectionLabelConverter.Instance}}" FontSize="11" Foreground="#999999" />
              <c:PixelPreview Session="{Binding $parent[ItemsControl].((vm:PreviewViewModel)DataContext).Session}"
                              Direction="{Binding}" HorizontalAlignment="Left" />
            </StackPanel>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      <StackPanel Spacing="4">
        <TextBlock Text="현재 방향 ×2" FontSize="11" Foreground="#999999" />
        <c:PixelPreview Session="{Binding Session}" Direction="{Binding Session.Direction}" Scale="2" HorizontalAlignment="Left" />
      </StackPanel>
    </StackPanel>
  </ScrollViewer>
</UserControl>
