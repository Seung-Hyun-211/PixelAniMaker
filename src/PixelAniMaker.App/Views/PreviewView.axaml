<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PixelAniMaker.App.ViewModels"
             xmlns:c="using:PixelAniMaker.App.Controls"
             xmlns:rig="using:PixelAniMaker.Core.Rigging"
             x:Class="PixelAniMaker.App.Views.PreviewView"
             x:DataType="vm:PreviewViewModel">
  <ScrollViewer HorizontalScrollBarVisibility="Auto">
    <StackPanel Margin="12" Spacing="12">
      <TextBlock Text="4방향 (×1) — 클릭하면 그 방향으로 전환" FontSize="11" Foreground="#999999" />
      <UniformGrid Columns="2" HorizontalAlignment="Left">
        <StackPanel Spacing="4" Margin="0,0,10,10">
          <TextBlock Text="정면" FontSize="11" Foreground="#999999" />
          <c:PixelPreview Session="{Binding Session}" Direction="{x:Static rig:Direction.Front}" HorizontalAlignment="Left" />
        </StackPanel>
        <StackPanel Spacing="4" Margin="0,0,10,10">
          <TextBlock Text="좌측면" FontSize="11" Foreground="#999999" />
          <c:PixelPreview Session="{Binding Session}" Direction="{x:Static rig:Direction.Left}" HorizontalAlignment="Left" />
        </StackPanel>
        <StackPanel Spacing="4" Margin="0,0,10,10">
          <TextBlock Text="우측면" FontSize="11" Foreground="#999999" />
          <c:PixelPreview Session="{Binding Session}" Direction="{x:Static rig:Direction.Right}" HorizontalAlignment="Left" />
        </StackPanel>
        <StackPanel Spacing="4" Margin="0,0,10,10">
          <TextBlock Text="후면" FontSize="11" Foreground="#999999" />
          <c:PixelPreview Session="{Binding Session}" Direction="{x:Static rig:Direction.Back}" HorizontalAlignment="Left" />
        </StackPanel>
      </UniformGrid>
      <StackPanel Spacing="4">
        <TextBlock Text="현재 방향 ×2" FontSize="11" Foreground="#999999" />
        <c:PixelPreview Session="{Binding Session}" Direction="{Binding Session.Direction}" Scale="2" HorizontalAlignment="Left" />
      </StackPanel>
    </StackPanel>
  </ScrollViewer>
</UserControl>
