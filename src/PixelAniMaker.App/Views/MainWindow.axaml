<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:PixelAniMaker.App.ViewModels"
        xmlns:svc="using:PixelAniMaker.App.Services"
        xmlns:rig="using:PixelAniMaker.Core.Rigging"
        x:Class="PixelAniMaker.App.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="{Binding Title}"
        Icon="/Assets/app.ico"
        Width="1400" Height="900"
        WindowStartupLocation="CenterScreen">

  <DockPanel>
    <Menu DockPanel.Dock="Top">
      <MenuItem Header="파일(_F)">
        <MenuItem Header="새로 만들기" InputGesture="{Binding Shortcuts.Gestures[New]}" Command="{Binding NewDocumentCommand}" />
        <MenuItem Header="새로 만들기 (관절 원 없는 마네킹)" Command="{Binding NewPlainDocumentCommand}" />
        <MenuItem Header="열기..." InputGesture="{Binding Shortcuts.Gestures[Open]}" Command="{Binding OpenCommand}" />
        <MenuItem Header="최근 파일" x:Name="RecentMenu" />
        <Separator />
        <MenuItem Header="저장" InputGesture="{Binding Shortcuts.Gestures[Save]}" Command="{Binding SaveCommand}" />
        <MenuItem Header="다른 이름으로 저장..." InputGesture="{Binding Shortcuts.Gestures[SaveAs]}" Command="{Binding SaveAsCommand}" />
        <Separator />
        <MenuItem Header="다른 프로젝트에서 동작 가져오기..." Command="{Binding ImportClipsCommand}" />
        <MenuItem Header="팔레트 불러오기..." Command="{Binding ImportPaletteCommand}" />
        <MenuItem Header="내보내기">
          <MenuItem Header="현재 동작 시트 PNG..." InputGesture="{Binding Shortcuts.Gestures[ExportSheet]}" Command="{Binding ExportCurrentSheetCommand}" />
          <MenuItem Header="전체 동작 통합 시트 PNG..." Command="{Binding ExportAllSheetCommand}" />
          <MenuItem Header="현재 동작 GIF..." Command="{Binding ExportGifCommand}" />
          <MenuItem Header="팔레트 (.gpl, .hex, .png)..." Command="{Binding ExportPaletteCommand}" />
          <Separator />
          <MenuItem Header="시트와 함께 JSON 메타데이터 저장" ToggleType="CheckBox"
                    IsChecked="{Binding WriteSheetMetadata, Mode=TwoWay}" />
        </MenuItem>
        <Separator />
        <MenuItem Header="종료" Click="OnExitClick" />
      </MenuItem>
      <MenuItem Header="편집(_E)">
        <MenuItem Header="되돌리기" InputGesture="{Binding Shortcuts.Gestures[Undo]}" Command="{Binding UndoCommand}" />
        <MenuItem Header="다시 하기" InputGesture="{Binding Shortcuts.Gestures[Redo]}" Command="{Binding RedoCommand}" />
      </MenuItem>
      <MenuItem Header="보기(_V)">
        <MenuItem Header="픽셀 격자" InputGesture="{Binding Shortcuts.Gestures[ToggleGrid]}" Command="{Binding ToggleGridCommand}"
                  ToggleType="CheckBox" IsChecked="{Binding Session.ShowGrid, Mode=OneWay}" />
        <MenuItem Header="다른 파츠 흐리게" InputGesture="{Binding Shortcuts.Gestures[ToggleDim]}" Command="{Binding ToggleDimOtherPartsCommand}"
                  ToggleType="CheckBox" IsChecked="{Binding Session.DimOtherParts, Mode=OneWay}" />
        <MenuItem Header="포즈 모드" InputGesture="{Binding Shortcuts.Gestures[TogglePose]}" Command="{Binding TogglePoseModeCommand}"
                  ToggleType="CheckBox" IsChecked="{Binding Session.PoseMode, Mode=OneWay}" />
        <Separator />
        <MenuItem Header="참고 이미지 불러오기 (지금 방향)..." Command="{Binding LoadReferenceCommand}" />
        <MenuItem Header="참고 이미지 지우기 (지금 방향)" Command="{Binding ClearReferenceCommand}" />
        <Separator />
        <MenuItem Header="확대" InputGesture="{Binding Shortcuts.Gestures[ZoomIn]}" Command="{Binding ZoomInCommand}" />
        <MenuItem Header="축소" InputGesture="{Binding Shortcuts.Gestures[ZoomOut]}" Command="{Binding ZoomOutCommand}" />
      </MenuItem>
      <MenuItem Header="애니메이션(_A)">
        <MenuItem Header="키 저장" InputGesture="{Binding Shortcuts.Gestures[SaveKey]}" Command="{Binding SaveKeyCommand}" />
        <MenuItem Header="키 삭제" Command="{Binding DeleteKeyCommand}" />
        <Separator />
        <MenuItem Header="이전 프레임" InputGesture="{Binding Shortcuts.Gestures[PreviousFrame]}" Command="{Binding PreviousFrameCommand}" />
        <MenuItem Header="다음 프레임" InputGesture="{Binding Shortcuts.Gestures[NextFrame]}" Command="{Binding NextFrameCommand}" />
        <MenuItem Header="어니언 스킨" InputGesture="{Binding Shortcuts.Gestures[ToggleOnion]}" Command="{Binding ToggleOnionSkinCommand}"
                  ToggleType="CheckBox" IsChecked="{Binding Animation.OnionSkin, Mode=OneWay}" />
        <Separator />
        <MenuItem Header="프레임 손보기" InputGesture="{Binding Shortcuts.Gestures[ToggleTouchup]}" Command="{Binding ToggleTouchupModeCommand}"
                  ToggleType="CheckBox" IsChecked="{Binding Session.TouchupMode, Mode=OneWay}" />
        <MenuItem Header="손본 내용 지우기 (현재 프레임)" Command="{Binding ClearTouchupCommand}" />
      </MenuItem>
      <MenuItem Header="창(_W)">
        <MenuItem Header="창 배치 초기화" Command="{Binding ResetLayoutCommand}" />
        <MenuItem Header="단축키 설정..." Command="{Binding EditShortcutsCommand}" />
        <MenuItem Header="언어 / Language">
          <MenuItem Header="한국어" ToggleType="Radio" IsChecked="{Binding IsKorean, Mode=OneWay}"
                    Command="{Binding SetLanguageCommand}" CommandParameter="ko" />
          <MenuItem Header="English" ToggleType="Radio" IsChecked="{Binding IsEnglish, Mode=OneWay}"
                    Command="{Binding SetLanguageCommand}" CommandParameter="en" />
        </MenuItem>
      </MenuItem>
    </Menu>

    <Border DockPanel.Dock="Bottom" Padding="10,4" Background="#1E1E22">
      <DockPanel>
        <TextBlock DockPanel.Dock="Right" Text="{Binding Session.CursorText}" Foreground="#AAAAAA" />
        <TextBlock Text="{Binding StatusText}" Foreground="#AAAAAA" />
      </DockPanel>
    </Border>

    <DockControl Layout="{Binding Layout}" Margin="4" />
  </DockPanel>
</Window>
