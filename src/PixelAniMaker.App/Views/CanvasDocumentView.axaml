<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PixelAniMaker.App.ViewModels"
             xmlns:c="using:PixelAniMaker.App.Controls"
             x:Class="PixelAniMaker.App.Views.CanvasDocumentView"
             x:DataType="vm:CanvasDocumentViewModel">
  <c:PixelCanvas Session="{Binding Session}" Animation="{Binding Animation}" />
</UserControl>
