<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PixelAniMaker.App.ViewModels"
             xmlns:svc="using:PixelAniMaker.App.Services"
             xmlns:conv="using:PixelAniMaker.App.Converters"
             x:Class="PixelAniMaker.App.Views.ToolboxView"
             x:DataType="vm:ToolboxViewModel">
  <ScrollViewer>
  <StackPanel Margin="8" Spacing="10">
    <TextBlock Text="방향" FontSize="11" Foreground="#999999" />
    <ListBox ItemsSource="{Binding Session.Directions}" SelectedItem="{Binding Session.Direction}">
      <ListBox.ItemsPanel>
        <ItemsPanelTemplate>
          <UniformGrid Columns="2" />
        </ItemsPanelTemplate>
      </ListBox.ItemsPanel>
      <ListBox.ItemTemplate>
        <DataTemplate>
          <TextBlock TextWrapping="Wrap">
            <TextBlock.Text>
              <MultiBinding Converter="{x:Static conv:ShortcutLabelConverter.Instance}">
                <Binding Converter="{x:Static conv:DirectionLabelConverter.Instance}" />
                <Binding Converter="{x:Static conv:DirectionLabelConverter.ShortcutId}" />
                <Binding Path="$parent[ListBox].((vm:ToolboxViewModel)DataContext).Shortcuts.Texts" />
              </MultiBinding>
            </TextBlock.Text>
          </TextBlock>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
    <TextBlock Text="도구" FontSize="11" Foreground="#999999" />
    <ListBox ItemsSource="{Binding Tools}" SelectedItem="{Binding Session.CurrentTool}" Tapped="OnToolTapped">
      <ListBox.ItemTemplate>
        <DataTemplate x:DataType="svc:ToolItem">
          <TextBlock>
            <TextBlock.Text>
              <MultiBinding Converter="{x:Static conv:ShortcutLabelConverter.Instance}">
                <Binding Path="Label" />
                <Binding Path="ShortcutId" />
                <Binding Path="$parent[ListBox].((vm:ToolboxViewModel)DataContext).Shortcuts.Texts" />
              </MultiBinding>
            </TextBlock.Text>
          </TextBlock>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
    <CheckBox IsChecked="{Binding Session.Symmetric}"
              ToolTip.Tip="정면·후면에서 그리면 몸 중심선 반대편(좌우 짝 파츠)에도 똑같이 그려집니다">
      <TextBlock Text="{Binding Shortcuts.Texts[ToggleSymmetry], StringFormat='대칭 그리기 ({0})'}" />
    </CheckBox>
    <CheckBox Content="픽셀 퍼펙트 연필" IsChecked="{Binding Session.PixelPerfect}"
              ToolTip.Tip="연필로 그을 때 계단 모서리의 군더더기 픽셀을 빼서 1px 선을 유지합니다" />
    <CheckBox IsChecked="{Binding Session.ShowGrid}">
      <TextBlock Text="{Binding Shortcuts.Texts[ToggleGrid], StringFormat='픽셀 격자 ({0})'}" />
    </CheckBox>
    <CheckBox IsChecked="{Binding Session.DimOtherParts}">
      <TextBlock Text="{Binding Shortcuts.Texts[ToggleDim], StringFormat='다른 파츠 흐리게 ({0})'}" />
    </CheckBox>
    <CheckBox Content="자동 외곽선" IsChecked="{Binding Session.AutoOutline}"
              ToolTip.Tip="회전 후 1px 외곽선과 파츠 경계선을 다시 그립니다. 엔진 셰이더로 외곽선을 넣을 거라면 끄세요." />
    <CheckBox Content="자동 명암" IsChecked="{Binding Session.AutoShading}"
              ToolTip.Tip="파츠마다 빛 반대쪽(아래와 옆) 가장자리를 팔레트에 있는 한 단계 어두운 색으로 칠합니다. 알맞은 어두운 색이 없는 색은 그대로 둡니다. 미리보기·애니메이션·내보내기에 모두 반영되고 프로젝트에 저장됩니다." />
    <StackPanel Spacing="4" Margin="24,0,0,0" IsVisible="{Binding Session.AutoShading}">
      <CheckBox Content="빛: 오른쪽 위" IsChecked="{Binding Session.ShadingFromRight}"
                ToolTip.Tip="끄면 빛이 왼쪽 위에서 옵니다" />
      <StackPanel Orientation="Horizontal" Spacing="8">
        <TextBlock Text="두께" VerticalAlignment="Center" />
        <NumericUpDown Value="{Binding Session.ShadingWidth}" Minimum="1" Maximum="3" Increment="1" FormatString="0" Width="110" />
      </StackPanel>
    </StackPanel>
    <CheckBox Content="관절 부드럽게" IsChecked="{Binding Session.SmoothJoints}"
              ToolTip.Tip="관절을 굽히면 파츠가 통째로 꺾이는 대신 관절 둘레(반경)에 걸쳐 휘어집니다. 부모와 자식이 관절에서 중간 각도로 만나, 굽힌 바깥쪽 틈과 이음새 선이 사라집니다. 남는 틈은 가까운 파츠 색으로 채웁니다. 색은 섞지 않습니다(팔레트 색만). 미리보기·애니메이션·내보내기에 반영되고 프로젝트에 저장됩니다." />
    <StackPanel Orientation="Horizontal" Spacing="8" Margin="24,0,0,0" IsVisible="{Binding Session.SmoothJoints}">
      <TextBlock Text="반경" VerticalAlignment="Center" />
      <NumericUpDown Value="{Binding Session.JointRadius}" Minimum="1" Maximum="24" Increment="1" FormatString="0" Width="110"
                     ToolTip.Tip="관절에서 몇 px까지 휘어짐이 퍼지는지. 팔다리 굵기 정도가 알맞습니다." />
    </StackPanel>
    <ToggleButton IsChecked="{Binding Session.PoseMode}" HorizontalAlignment="Stretch">
      <TextBlock Text="{Binding Shortcuts.Texts[TogglePose], StringFormat='포즈 모드 ({0})'}" />
    </ToggleButton>
    <CheckBox IsChecked="{Binding Session.SkeletonEdit}"
              ToolTip.Tip="포즈 모드에서 파츠를 끌면 돌리는 대신 옮깁니다 (아래 파츠도 함께: 상완 → 전완·손). 관절 점을 끌면 그림은 두고 회전 중심만 옮깁니다. Alt = 고른 파츠, Shift = 가로·세로로만. 방향마다 따로 정하고, 끌기 한 번이 되돌리기 한 번입니다.">
      <TextBlock Text="{Binding Shortcuts.Texts[ToggleSkeleton], StringFormat='뼈대 편집 ({0})'}" />
    </CheckBox>
    <CheckBox Content="좌우 짝도 함께 (L·R)" IsChecked="{Binding Session.SkeletonMirror}" Margin="24,0,0,0"
              IsVisible="{Binding Session.SkeletonEdit}"
              ToolTip.Tip="L·R 짝 파츠를 같이 옮깁니다. 정면·후면에서는 몸 중심선에 대해 반대로(어깨를 좁히면 양쪽이 함께 안으로), 옆·반측면에서는 같은 방향으로 옮깁니다." />
    <TextBlock Text="참고 이미지" FontSize="11" Foreground="#999999" />
    <TextBlock Text="보기 → 참고 이미지 불러오기 (방향마다 따로)" FontSize="12" Foreground="#999999" TextWrapping="Wrap"
               IsVisible="{Binding !Session.Reference.HasImage}" />
    <StackPanel Spacing="6" IsVisible="{Binding Session.Reference.HasImage}">
      <StackPanel Orientation="Horizontal" Spacing="10">
        <CheckBox Content="보기" IsChecked="{Binding Session.Reference.Visible}" />
        <CheckBox Content="캐릭터 위에" IsChecked="{Binding Session.Reference.OnTop}" />
      </StackPanel>
      <DockPanel>
        <TextBlock Text="불투명도" VerticalAlignment="Center" Margin="0,0,8,0" />
        <Slider Minimum="0.05" Maximum="1" Value="{Binding Session.Reference.Opacity}" />
      </DockPanel>
      <StackPanel Orientation="Horizontal" Spacing="6">
        <TextBlock Text="크기 %" VerticalAlignment="Center" Width="42" />
        <NumericUpDown Value="{Binding Session.Reference.Current.Scale, FallbackValue=100}" Minimum="1" Maximum="2000"
                       Increment="5" FormatString="0.#" Width="110" />
      </StackPanel>
      <StackPanel Orientation="Horizontal" Spacing="6">
        <TextBlock Text="위치 X" VerticalAlignment="Center" Width="42" />
        <NumericUpDown Value="{Binding Session.Reference.Current.X, FallbackValue=0}" Minimum="-1000" Maximum="1000"
                       Increment="1" FormatString="0" Width="110" />
      </StackPanel>
      <StackPanel Orientation="Horizontal" Spacing="6">
        <TextBlock Text="위치 Y" VerticalAlignment="Center" Width="42" />
        <NumericUpDown Value="{Binding Session.Reference.Current.Y, FallbackValue=0}" Minimum="-1000" Maximum="1000"
                       Increment="1" FormatString="0" Width="110" />
      </StackPanel>
    </StackPanel>
    <TextBlock Foreground="#999999" TextWrapping="Wrap" FontSize="12"
               Text="그리기: 선택한 파츠에만 찍힘 · 왼쪽 클릭 주 색, 오른쪽 클릭 보조 색&#10;선택·이동: 끌어서 영역 선택, 영역 안을 끌면 이동 · Delete 지우기 · Esc 해제&#10;포즈: 파츠를 끌어서 관절 기준 회전, Shift로 15° 단위, Alt+드래그는 선택한 파츠를 회전(가려진 파츠용)&#10;휠: 확대/축소 · 휠 클릭 또는 Space+드래그: 이동" />
  </StackPanel>
  </ScrollViewer>
</UserControl>
