<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PixelAniMaker.App.ViewModels"
             x:Class="PixelAniMaker.App.Views.PartsView"
             x:DataType="vm:PartsViewModel">
  <Grid Margin="8" RowDefinitions="*,6,*">
    <ScrollViewer Grid.Row="2">
    <StackPanel Spacing="6" Margin="0,4,0,0">
      <TextBlock Text="{Binding Session.ActivePartBlockedReason}" FontSize="11" Foreground="#E0B060" TextWrapping="Wrap"
                 IsVisible="{Binding Session.ActivePartBlockedReason, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
      <StackPanel Orientation="Horizontal" Spacing="6" IsEnabled="{Binding !Session.IsActivePartLocked}">
        <TextBlock Text="회전" VerticalAlignment="Center" />
        <NumericUpDown Value="{Binding Rotation}" Minimum="-180" Maximum="180" Increment="5"
                       FormatString="0.#" Width="120" />
        <TextBlock Text="°" VerticalAlignment="Center" />
      </StackPanel>
      <StackPanel Orientation="Horizontal" Spacing="6" ToolTip.Tip="몸 전체 위치 (px). 점프·숨쉬기 등에 사용">
        <TextBlock Text="몸 X" VerticalAlignment="Center" />
        <NumericUpDown Value="{Binding OffsetX}" Minimum="-64" Maximum="64" Increment="1" FormatString="0" Width="95" />
        <TextBlock Text="Y" VerticalAlignment="Center" />
        <NumericUpDown Value="{Binding OffsetY}" Minimum="-64" Maximum="64" Increment="1" FormatString="0" Width="95" />
      </StackPanel>
      <StackPanel Spacing="4" IsVisible="{Binding IsDetailPart}" IsEnabled="{Binding !Session.IsActivePartLocked}"
                  ToolTip.Tip="이 방향에서 눈 파츠의 위치 (관절 = 눈 가운데, 캔버스 px). 방향마다 따로 정하고, 되돌리기가 됩니다.">
        <StackPanel Orientation="Horizontal" Spacing="6">
          <TextBlock Text="눈 X" VerticalAlignment="Center" Width="32" />
          <NumericUpDown Value="{Binding DetailX}" Increment="1" FormatString="0" Minimum="-512" Maximum="512" Width="130" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="6">
          <TextBlock Text="눈 Y" VerticalAlignment="Center" Width="32" />
          <NumericUpDown Value="{Binding DetailY}" Increment="1" FormatString="0" Minimum="-512" Maximum="512" Width="130" />
        </StackPanel>
      </StackPanel>
      <CheckBox Content="반전 끊고 따로 그리기" IsChecked="{Binding OwnRight}" IsVisible="{Binding IsRightView}"
                ToolTip.Tip="끄면 이 파츠는 반대 방향(우측면은 좌측면, 반측면 (우)는 반측면 (좌))을 좌우 반전해 씁니다. 켜면 그 그림을 복사한 별도 이미지에 그립니다 (비대칭 디자인용). 다시 끄면 따로 그린 이미지는 버려집니다 (되돌리기 가능)." />
      <TextBlock Text="{Binding VariantStatus}" FontSize="11" Foreground="#999999" TextWrapping="Wrap" />
      <StackPanel Orientation="Horizontal" Spacing="6">
        <Button Content="이 각도 이미지 만들기" Command="{Binding AddVariantCommand}"
                ToolTip.Tip="지금 회전에 가까운 45° 각도용 이미지를 만듭니다. 그 각도 근처에서는 이 이미지를 직접 다듬어 씁니다 (손처럼 작은 파츠용)." />
        <Button Content="지우기" Command="{Binding RemoveVariantCommand}"
                ToolTip.Tip="지금 쓰이는 각도 이미지를 지웁니다" />
      </StackPanel>
      <TextBlock Text="{Binding VariantMessage}" FontSize="11" Foreground="#E0B060" TextWrapping="Wrap"
                 IsVisible="{Binding VariantMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
      <TextBlock Text="레이어 (위가 앞 · 체크 = 보이기 · 고른 레이어에 그려짐)" FontSize="11" Foreground="#999999" TextWrapping="Wrap" />
      <ListBox ItemsSource="{Binding Layers}" SelectedItem="{Binding SelectedLayer}" MaxHeight="140">
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="vm:LayerItem">
            <StackPanel Orientation="Horizontal" Spacing="4">
              <CheckBox IsChecked="{Binding Visible}" MinWidth="0" ToolTip.Tip="보이기" />
              <TextBox Text="{Binding Name, UpdateSourceTrigger=LostFocus}" Width="150" />
            </StackPanel>
          </DataTemplate>
        </ListBox.ItemTemplate>
        <ListBox.Styles>
          <Style Selector="ListBoxItem">
            <Setter Property="Padding" Value="4,2" />
          </Style>
        </ListBox.Styles>
      </ListBox>
      <StackPanel Orientation="Horizontal" Spacing="4">
        <Button Content="추가" Command="{Binding AddLayerCommand}" ToolTip.Tip="고른 레이어 위에 빈 레이어 추가" />
        <Button Content="삭제" Command="{Binding RemoveLayerCommand}" ToolTip.Tip="고른 레이어 삭제 (마지막 하나는 남음)" />
        <Button Content="▲" Command="{Binding LayerUpCommand}" ToolTip.Tip="앞으로" />
        <Button Content="▼" Command="{Binding LayerDownCommand}" ToolTip.Tip="뒤로" />
      </StackPanel>
      <TextBlock Text="장착점 (이 파츠 · 지금 방향 · 파츠 이미지 픽셀 좌표)" FontSize="11" Foreground="#999999" TextWrapping="Wrap" />
      <ItemsControl ItemsSource="{Binding Attachments}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:AttachmentItem">
            <StackPanel Spacing="4" Margin="0,0,0,6">
              <StackPanel Orientation="Horizontal" Spacing="4">
                <TextBox Text="{Binding Name, UpdateSourceTrigger=LostFocus}" Width="160" ToolTip.Tip="이름 (엔진에서 찾을 때 씀)" />
                <Button Content="✕" Command="{Binding RemoveCommand}" ToolTip.Tip="장착점 삭제" />
              </StackPanel>
              <StackPanel Orientation="Horizontal" Spacing="4">
                <TextBlock Text="X" VerticalAlignment="Center" />
                <NumericUpDown Value="{Binding X}" Increment="1" FormatString="0.#" Minimum="-256" Maximum="256" Width="105" />
                <TextBlock Text="Y" VerticalAlignment="Center" />
                <NumericUpDown Value="{Binding Y}" Increment="1" FormatString="0.#" Minimum="-256" Maximum="256" Width="105" />
              </StackPanel>
            </StackPanel>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      <Button Content="장착점 추가" Command="{Binding AddAttachmentCommand}"
              ToolTip.Tip="무기·이펙트 위치 등. 파츠를 따라 움직이고, 시트 JSON에 프레임마다 위치와 각도로 기록됩니다." />
      <StackPanel Orientation="Horizontal" Spacing="6">
        <Button Content="이 파츠 0°" Command="{Binding ResetPartCommand}" IsEnabled="{Binding !Session.IsActivePartLocked}" />
        <Button Content="포즈 초기화" Command="{Binding ResetPoseCommand}" />
      </StackPanel>
      <StackPanel Orientation="Horizontal" Spacing="6">
        <Button Content="눈 파츠 추가" Command="{Binding AddEyesCommand}" IsVisible="{Binding Session.CanAddEyes}"
                ToolTip.Tip="머리에 붙는 눈 파츠(눈 R·눈 L)를 따로 만듭니다. 얼굴과 따로 그리고 바꿀 수 있고, 머리와 만나는 곳에는 선이 생기지 않습니다." />
        <Button Content="눈 파츠 삭제" Command="{Binding RemoveEyesCommand}" IsVisible="{Binding Session.HasEyes}" />
      </StackPanel>
    </StackPanel>
    </ScrollViewer>
    <GridSplitter Grid.Row="1" ResizeDirection="Rows" />
    <ListBox Grid.Row="0" ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}">
      <ListBox.ItemTemplate>
        <DataTemplate x:DataType="vm:PartItem">
          <StackPanel Orientation="Horizontal" Spacing="4">
            <CheckBox IsChecked="{Binding Visible}" MinWidth="0" MinHeight="0" Height="22" Padding="0"
                      ToolTip.Tip="캔버스에 보이기 (끄면 편집 캔버스에서만 숨김 — 미리보기·애니메이션·내보내기에는 그대로 나옵니다)" />
            <ToggleButton IsChecked="{Binding Locked}" Content="잠금" FontSize="10" Padding="4,0" MinHeight="0" Height="18"
                          VerticalAlignment="Center"
                          ToolTip.Tip="잠그면 이 파츠에 그리기·회전·위치 옮기기가 막힙니다 (고르기는 됨). 저장되지 않는 편집 보조 기능입니다." />
            <TextBlock Text="{Binding Display}" xml:space="preserve" VerticalAlignment="Center" />
          </StackPanel>
        </DataTemplate>
      </ListBox.ItemTemplate>
      <ListBox.Styles>
        <Style Selector="ListBoxItem">
          <Setter Property="Padding" Value="6,1" />
        </Style>
      </ListBox.Styles>
    </ListBox>
  </Grid>
</UserControl>
