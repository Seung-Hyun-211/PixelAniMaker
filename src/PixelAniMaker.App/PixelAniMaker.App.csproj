<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <RootNamespace>PixelAniMaker.App</RootNamespace>
    <AssemblyName>PixelAniMaker</AssemblyName>
    <ApplicationIcon>Assets/app.ico</ApplicationIcon>
    <Version>0.1.0</Version>
    <Product>PixelAniMaker</Product>
    <Description>4등신 도트 캐릭터 파츠·스켈레톤 애니메이션 제작 툴</Description>
  </PropertyGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.3" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.3" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.3" />
    <PackageReference Include="Dock.Avalonia" Version="12.1.0.6" />
    <PackageReference Include="Dock.Avalonia.Themes.Fluent" Version="12.1.0.6" />
    <PackageReference Include="Dock.Model.Mvvm" Version="12.1.0.6" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PixelAniMaker.Core\PixelAniMaker.Core.csproj" />
  </ItemGroup>

</Project>
